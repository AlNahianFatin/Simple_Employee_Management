@model LoginDTO
@{
	ViewData["Title"] = "Login";
}

@if (ViewBag.Error != null)
{
	<div class="alert alert-dismissible alert-danger">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@ViewBag.Error</P>
	</div>
}

@if (ViewBag.Success != null)
{
	<div class="alert alert-dismissible alert-success">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@ViewBag.Success</P>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-dismissible alert-danger">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@TempData["Error"]</P>
	</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-dismissible alert-success">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@TempData["Success"]</P>
	</div>
}

<h2>Login</h2>

<form asp-action="Login" asp-controller="Credential" method="post">
	<div>
		<label asp-for="Email" class="form-label mt-4"></label>
		<input type="email" class="form-control" placeholder="Enter Email" asp-for="Email" />
		<span asp-validation-for="Email" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Password" class="form-label mt-4"></label>
		<input type="password" class="form-control" placeholder="Enter Password" asp-for="Password" />
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div class="d-flex justify-content-center mt-4">
		<button type="submit" class="btn btn-primary">Login</button>
	</div>
</form>