@model EmployeeDTO
@{
	ViewData["Title"] = "Update Employees";
}

<form method="post" action="#">
	<input type="hidden" asp-for="Id" />

	<div>
		<label asp-for="Id" class="form-label mt-4"></label>
		<input type="text" class="form-control" asp-for="Id" disabled="disabled" />
		<span asp-validation-for="Id" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="FirstName" class="form-label mt-4"></label>
		<input type="text" class="form-control" placeholder="Enter First Name" asp-for="FirstName" />
		<span asp-validation-for="FirstName" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="LastName" class="form-label mt-4"></label>
		<input type="text" class="form-control" placeholder="Enter Last Name" asp-for="LastName" />
		<span asp-validation-for="LastName" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Position" class="form-label mt-4"></label>
		<input type="text" class="form-control" placeholder="Enter Position" asp-for="Position" />
		<span asp-validation-for="Position" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Salary" class="form-label mt-4"></label>
		<input type="number" class="form-control" placeholder="Enter Salary" asp-for="Salary" />
		<span asp-validation-for="Salary" class="text-danger"></span>
	</div>

	<div class="d-flex justify-content-center mt-4">
		<button type="submit" class="btn btn-primary">Update Employee</button>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}