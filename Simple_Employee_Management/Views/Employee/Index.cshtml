@model List<EmployeeDTO>
@{
	ViewData["Title"] = "Employees";
}

@if (ViewBag.Error != null)
{
	<div class="alert alert-dismissible alert-danger">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@ViewBag.Error</P>
	</div>
}

@if (ViewBag.Success != null)
{
	<div class="alert alert-dismissible alert-success">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@ViewBag.Success</P>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-dismissible alert-danger">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@TempData["Error"]</P>
	</div>
}

@if (TempData["Success"] != null)
{
	<div class="alert alert-dismissible alert-success">
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		<p>@TempData["Success"]</P>
	</div>
}

<h2>Users</h2>

<table class="table-striped table">
	<thead>
	<tr>
		<th>Id</th>
		<th>First Name</th>
		<th>Last Name</th>
		<th>Position</th>
		<th>Salary</th>
		<th><a asp-action="Add" class="btn btn-sm btn-success">New Employee</a></th>
	</tr>
	</thead>
	<tbody>
	@foreach (var emp in Model)
	{
		<tr>
			<td>@emp.Id</td>
			<td>@emp.FirstName</td>
			<td>@emp.LastName</td>
			<td>@emp.Position</td>
			<td>@emp.Salary</td>
			<td>
				<a asp-action="Update" asp-route-Id="@emp.Id" class="btn btn-sm btn-primary">Update</a>
				<a onclick="return confirm('Are you sure?')" asp-action="Delete" asp-route-Id="@emp.Id" class="btn btn-sm btn-danger">Delete</a>
			</td>
		</tr>
	}
	</tbody>
</table>