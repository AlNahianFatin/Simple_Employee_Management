@model AdminDTO
@{
	ViewData["Title"] = "Update Admins";
}

<form method="post" action="#">
	<input type="hidden" asp-for="AdminId" />

	<div>
		<label asp-for="AdminId" class="form-label mt-4"></label>
		<input type="text" class="form-control" asp-for="AdminId" disabled="disabled" />
		<span asp-validation-for="AdminId" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Username" class="form-label mt-4"></label>
		<input type="text" class="form-control" placeholder="Enter Username" asp-for="Username" />
		<span asp-validation-for="Username" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Password" class="form-label mt-4"></label>
		<input type="text" class="form-control" placeholder="Enter Password" asp-for="Password" />
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>
	<div>
		<label asp-for="Email" class="form-label mt-4"></label>
		<input type="email" class="form-control" placeholder="Enter Email" asp-for="Email" />
		<span asp-validation-for="Email" class="text-danger"></span>
	</div>

	<div class="d-flex justify-content-center mt-4">
		<button type="submit" class="btn btn-primary">Update Admin</button>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}